service cloud.firestore {
  match /databases/{database}/documents {
    match /penginapan/data {
      allow read: if true;
      allow write: if true;

      match /produk/{penginapanId} {
        allow read, write: if true;
      }
    }
    match /user/{uid} {
      allow read, write: if request.auth.uid == uid;
      match /penginapan/pesan {
        allow read, write: if request.auth.uid == uid;
    }
    }
    
  }
}
