rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /penginapan/data {
      allow read: if true;
      allow write: if true;

      match /produk/{penginapanId} {
        allow read, write: if true;
      }

    }
    match /user/{uid}/pesanan/{penginapanId} {
      allow read, write: if request.auth.uid == uid;
      
    }
    match /user/{uid}/suka/{penginapanId} {
      allow read, write: if request.auth.uid == uid;
      
    }

    match /pesanan/{penginapanId} {
      allow read, write: if true;
    }
    
    match /session/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    match /user {
      allow read, write: if true;
    }
     match /user/{penginapanId} {
       allow read, write: if true;
     }

     match /userbio/{genId} {
       allow read, write: if true;
     }

     match /userbio {
       allow read: if true;
     }

     match /imgthumbnail/{idImg} {
       allow read, write: if true;
     }

     match /kota/{genId}{
       allow read, write: if true;
     }

     match /rating/{ratingId} {
       allow read, write: if true;
     }

     match /promosi/{imgId} {
       allow read, write: if true;
     }

     match /notification/{notification}{
       allow read, write: if true;
     }

     match /airIsiUlang/{orderId} {
       allow read, write: if true;
     }

     match /dataAlamat/{alamatId} {
       allow read, write: if true;
     }

     match /historyAirIsiUlang/{orderId} {
       allow read, write: if true;
     }

  }
}
