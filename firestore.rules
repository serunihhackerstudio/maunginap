rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /penginapan/data {
      allow read: if true;
      allow write: if true;

      match /produk/{penginapanId} {
        allow read, write: if true;
      }

    }
    match /user/{uid}/pesanan/{penginapanId} {
      allow read, write: if request.auth.uid == uid;
      
    }
    match /user/{uid}/suka/{penginapanId} {
      allow read, write: if request.auth.uid == uid;
      
    }
    match /pesanan/{uid} {
        allow read, write: if request.auth.uid == uid;
      }
    
    match /session/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
  
  }
}
